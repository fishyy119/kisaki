{
  "extends": "../../tsconfig.base.json",
  "include": [
    "env.d.ts",
    "tools/**/*",
    "src/main/**/*",
    "src/main/**/*.json",
    "src/extension-host/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "types": ["node"],
    // Desktop app code predates exactOptionalPropertyTypes; the internal DTO
    // surface (~400 sites) is not yet migrated. Contract packages and all
    // extensions enforce it via the root base. TODO: migrate and drop this
    // opt-out once the desktop DTO surface adopts explicit `| undefined`.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@main/*": ["./src/main/*"],
      "@extension-host/*": ["./src/extension-host/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
