{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/renderer/src/**/*.json",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    // Desktop app code predates exactOptionalPropertyTypes; see
    // tsconfig.node.json for the migration note.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@assets/*": ["./src/renderer/assets/*"]
    }
  }
}
