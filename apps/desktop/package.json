{
  "name": "kisaki",
  "version": "0.0.6",
  "description": "An ACGN library manager",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "ximu",
  "homepage": "https://github.com/ximu3/kisaki",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:webview-fonts && tsx tools/builtin-extensions/cli.ts watch -- tsx tools/bundler/cli.ts dev",
    "start": "pnpm run build:webview-fonts && tsx tools/builtin-extensions/cli.ts build --target=dev && tsx tools/bundler/cli.ts start",
    "build": "tsx tools/builtin-extensions/cli.ts build --target=resources && pnpm run build:webview-fonts && pnpm run typecheck && tsx tools/bundler/cli.ts build",
    "build:webview-fonts": "tsx tools/webview-fonts/cli.ts build",
    "build:unpack": "pnpm run build && pnpm run ensure:media-binaries && electron-builder --dir",
    "build:win:unpack": "pnpm run build && pnpm run ensure:media-binaries && electron-builder --win --dir",
    "build:win": "pnpm run build && pnpm run ensure:media-binaries && electron-builder --win --publish never",
    "build:mac": "pnpm run build && pnpm run ensure:media-binaries && electron-builder --mac --publish never",
    "build:linux": "pnpm run build && pnpm run ensure:media-binaries && electron-builder --linux --publish never",
    "fetch:media-binaries": "tsx tools/media-binaries/cli.ts fetch",
    "ensure:media-binaries": "tsx tools/media-binaries/cli.ts ensure",
    "stage:media-binaries": "tsx tools/media-binaries/cli.ts stage",
    "check:media-binaries": "tsx tools/media-binaries/cli.ts check",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf out dist resources/bin resources/extensions resources/webview-fonts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.4",
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-registry": "workspace:*",
    "@ximu3/process-list": "^0.0.2",
    "@zip.js/zip.js": "^2.8.57",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "catalog:",
    "cron-parser": "^5.6.1",
    "cross-spawn": "catalog:",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fflate": "catalog:",
    "file-type": "^22.0.1",
    "nanoid": "^5.1.16",
    "node-stream-zip": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.2.108",
    "semver": "catalog:",
    "sharp": "^0.35.3",
    "smartcrop-sharp": "^2.0.8"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/noto-sans-mono": "^5.2.10",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@iconify/json": "^2.2.498",
    "@iconify/tailwind4": "catalog:",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-virtual": "^3.13.31",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "catalog:",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@uiw/codemirror-themes": "^4.25.11",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vitejs/plugin-vue": "catalog:",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-kit": "^0.31.10",
    "electron": "41.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier": "catalog:",
    "reka-ui": "catalog:",
    "rimraf": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-codemirror6": "^1.6.1",
    "vue-eslint-parser": "catalog:",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "catalog:"
  }
}
