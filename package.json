{
  "name": "kisaki-monorepo",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Kisaki ACGN Library Manager - Monorepo",
  "scripts": {
    "dev": "pnpm --filter kisaki dev",
    "build": "pnpm --filter kisaki build",
    "build:win": "pnpm --filter kisaki build:win",
    "build:mac": "pnpm --filter kisaki build:mac",
    "build:linux": "pnpm --filter kisaki build:linux",
    "check:extension-tooling": "tsx tools/extension-tooling/cli.ts check",
    "version:extension-tooling": "tsx tools/extension-tooling/cli.ts set-version",
    "build:extension-tooling": "tsx tools/extension-tooling/cli.ts build",
    "verify:extension-tooling": "tsx tools/extension-tooling/cli.ts verify-output",
    "typecheck": "pnpm build:extension-tooling && tsc --noEmit -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "pnpm -r --parallel clean",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "cross-spawn": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jiti": "catalog:",
    "lefthook": "^2.1.10",
    "prettier": "catalog:",
    "tar": "7.5.19",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
