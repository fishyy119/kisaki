{
  "name": "kisaki-monorepo",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "description": "Kisaki Multimedia Library Manager - Monorepo",
  "scripts": {
    "dev": "pnpm --filter kisaki dev",
    "build": "pnpm --filter kisaki build",
    "build:win": "pnpm --filter kisaki build:win",
    "build:mac": "pnpm --filter kisaki build:mac",
    "build:linux": "pnpm --filter kisaki build:linux",
    "check:extension-tooling": "tsx tools/extension-tooling/cli.ts check",
    "version:extension-tooling": "tsx tools/extension-tooling/cli.ts set-version",
    "build:extension-tooling": "tsx tools/extension-tooling/cli.ts build",
    "verify:extension-tooling": "tsx tools/extension-tooling/cli.ts verify-output",
    "pack:extension-tooling": "tsx tools/extension-tooling/cli.ts pack",
    "publish:extension-tooling": "tsx tools/extension-tooling/cli.ts publish",
    "typecheck": "pnpm build:extension-tooling && pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r --parallel clean",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.1",
    "cross-spawn": "^7.0.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "lefthook": "^2.0.12",
    "prettier": "^3.7.4",
    "tar": "7.5.9",
    "tsdown": "^0.19.0",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.49.0"
  }
}
