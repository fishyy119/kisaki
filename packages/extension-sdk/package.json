{
  "name": "@kisaki3/extension-sdk",
  "version": "0.0.10",
  "description": "Authoring SDK for the Kisaki extension system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/extension-sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webview": {
      "import": {
        "types": "./dist/webview.d.mts",
        "default": "./dist/webview.mjs"
      },
      "require": {
        "types": "./dist/webview.d.cts",
        "default": "./dist/webview.cjs"
      }
    },
    "./base.css": "./base.css",
    "./tailwind.css": "./tailwind.css",
    "./preview.css": "./preview.css"
  },
  "files": [
    "dist",
    "base.css",
    "tailwind.css",
    "preview.css",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kisaki3/extension-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kisaki",
    "extension",
    "sdk"
  ],
  "license": "MIT"
}
