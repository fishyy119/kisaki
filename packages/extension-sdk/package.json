{
  "name": "@kisaki3/extension-sdk",
  "version": "0.0.13",
  "description": "Authoring SDK for the Kisaki extension system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/extension-sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./webview": {
      "types": "./dist/webview.d.mts",
      "default": "./dist/webview.mjs"
    },
    "./base.css": "./base.css",
    "./tailwind.css": "./tailwind.css",
    "./preview.css": "./preview.css"
  },
  "files": [
    "dist",
    "base.css",
    "tailwind.css",
    "preview.css",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kisaki3/extension-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "kisaki",
    "extension",
    "sdk"
  ],
  "license": "MIT"
}
