{
  "name": "@kisaki3/extension-ui-vue",
  "version": "0.0.13",
  "description": "Vue UI kit for Kisaki extension webview documents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/extension-ui-vue"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "@kisaki3/extension-sdk": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@kisaki3/extension-sdk": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  },
  "keywords": [
    "kisaki",
    "extension",
    "webview",
    "ui",
    "vue"
  ],
  "license": "MIT"
}
