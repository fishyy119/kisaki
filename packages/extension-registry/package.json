{
  "name": "@kisaki/extension-registry",
  "version": "0.0.1",
  "description": "Distributed registry contracts and tooling for Kisaki extensions",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      }
    },
    "./schemas/extension-registry.schema.json": "./schemas/extension-registry.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kisaki/extension-api": "workspace:*",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kisaki",
    "extension",
    "registry"
  ],
  "license": "MIT"
}
