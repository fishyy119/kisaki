{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kisaki Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "categories", "entry", "engines"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*(?:^|\\.)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
    },
    "name": {
      "$ref": "#/$defs/localizedText"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[vV]?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["scraper", "tool", "theme", "integration"]
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.mjs$"
    },
    "ui": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
      "description": "Package-relative root directory of built webview UI assets, e.g. ./dist/ui. Required for the extension to open webviews."
    },
    "description": {
      "$ref": "#/$defs/localizedText"
    },
    "author": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kisakiExtensionApi"],
      "properties": {
        "kisakiExtensionApi": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[0-9A-Za-zvVxX*~^<>=|.\\-+\\s]+$",
          "description": "Kisaki Extension API version range. Runtime validation uses semver.validRange; this schema restricts the string to semver range syntax characters."
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "description": "A plain string is a language-neutral default. The object form requires en as the resolution baseline and may add any supported UI locale.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["en"],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ja": {
              "type": "string",
              "minLength": 1
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            },
            "zh-Hant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
