{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaki.dev/schemas/extension-manifest.schema.json",
  "title": "Kisaki Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "categories", "entry"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["scraper", "tool", "theme", "integration"]
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kisaki": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
