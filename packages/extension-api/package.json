{
  "name": "@kisaki3/extension-api",
  "version": "0.0.2",
  "description": "Public contracts for the Kisaki extension system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/extension-api"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas/extension-manifest.schema.json": "./schemas/extension-manifest.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kisaki",
    "extension",
    "api",
    "contracts"
  ],
  "license": "MIT"
}
