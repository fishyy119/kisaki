{
  "name": "@kisaki3/extension-cli",
  "version": "0.0.13",
  "description": "CLI tools for Kisaki extension development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/extension-cli"
  },
  "type": "module",
  "bin": {
    "kisx": "./dist/index.mjs"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-registry": "workspace:*",
    "chokidar": "catalog:",
    "commander": "catalog:",
    "cross-spawn": "catalog:",
    "fflate": "catalog:",
    "kolorist": "catalog:",
    "semver": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "kisaki",
    "extension",
    "cli",
    "kisx"
  ],
  "license": "MIT"
}
