{
  "name": "@kisaki3/extension-cli",
  "version": "0.0.9",
  "description": "CLI tools for Kisaki extension development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/extension-cli"
  },
  "type": "module",
  "bin": {
    "kisx": "./dist/index.mjs"
  },
  "exports": {
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-registry": "workspace:*",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "kolorist": "^1.8.0",
    "semver": "^7.7.3",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "rollup": "^4.52.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "kisaki",
    "extension",
    "cli",
    "kisx"
  ],
  "license": "MIT"
}
