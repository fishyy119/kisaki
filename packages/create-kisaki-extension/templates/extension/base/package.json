{
  "name": "{{PACKAGE_NAME}}",
  "private": true,
  "description": "{{DESCRIPTION}}",
  "type": "module",
  "packageManager": "{{PACKAGE_MANAGER}}",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "kisx build",
    "dev": "kisx dev",
    "validate": "kisx validate",
    "pack": "kisx pack",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.host.json --composite false",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@kisaki3/extension-api": "^{{TOOLING_VERSION}}",
    "@kisaki3/extension-cli": "^{{TOOLING_VERSION}}",
    "@kisaki3/extension-sdk": "^{{TOOLING_VERSION}}",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "keywords": [
    "kisaki",
    "extension"
  ],
  "license": "MIT"
}
