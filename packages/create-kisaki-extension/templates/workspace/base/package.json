{
  "name": "{{WORKSPACE_PACKAGE_NAME}}",
  "private": true,
  "description": "{{WORKSPACE_PACKAGE_DESCRIPTION}}",
  "packageManager": "{{WORKSPACE_PACKAGE_MANAGER}}",
  "engines": {
    "node": "{{WORKSPACE_NODE_ENGINE_RANGE}}"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "validate": "pnpm -r --if-present run validate",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present run typecheck",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint . && pnpm -r --if-present run lint",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix . && pnpm -r --if-present run lint:fix",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "key:generate": "kisx key generate --out .keys/author.ed25519.json",
    "prepare": "tsx tools/install-hooks.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kisaki3/extension-cli": "^{{KISAKI_TOOLING_VERSION}}",
    "@kisaki3/extension-registry": "^{{KISAKI_TOOLING_VERSION}}",
    "@types/node": "{{NODE_TYPES_VERSION}}",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
