{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Kisaki Extension",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "windows": {
        "runtimeExecutable": "pnpm.cmd"
      },
      "runtimeArgs": ["run", "dev"],
      "autoAttachChildProcesses": true,
      "console": "internalConsole",
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
