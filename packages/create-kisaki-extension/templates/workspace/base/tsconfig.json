{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [".github/scripts/**/*.ts", "tools/**/*.ts", "eslint.config.ts"]
}
