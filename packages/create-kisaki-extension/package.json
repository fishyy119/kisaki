{
  "name": "create-kisaki-extension",
  "version": "0.0.13",
  "description": "Scaffolding tool to create Kisaki extensions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/create-kisaki-extension"
  },
  "type": "module",
  "bin": {
    "create-kisaki-extension": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-registry": "workspace:*",
    "commander": "catalog:",
    "cross-spawn": "catalog:",
    "kolorist": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "kisaki",
    "extension",
    "create",
    "scaffolding"
  ],
  "license": "MIT"
}
