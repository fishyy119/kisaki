{
  "name": "create-kisaki-extension",
  "version": "0.0.3",
  "description": "Scaffolding tool to create Kisaki extensions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "packages/create-kisaki-extension"
  },
  "type": "module",
  "bin": {
    "create-kisaki-extension": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kisaki3/extension-api": "workspace:*",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "kolorist": "^1.8.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.1",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kisaki",
    "extension",
    "create",
    "scaffolding"
  ],
  "license": "MIT"
}
