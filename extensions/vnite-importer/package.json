{
  "name": "@kisaki3/builtin-vnite-importer",
  "version": "0.0.1",
  "description": "Built-in Vnite database backup importer for Kisaki",
  "type": "module",
  "scripts": {
    "build": "kisx build",
    "dev": "kisx dev",
    "validate": "kisx validate",
    "pack": "kisx pack",
    "test:backup": "tsx scripts/test-backup-reader.ts",
    "test:import": "tsx scripts/test-import-executor.ts",
    "test:mapping": "tsx scripts/test-mapping.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.host.json --composite false && vue-tsc --noEmit -p tsconfig.ui.json --composite false"
  },
  "dependencies": {
    "@kisaki3/extension-sdk": "workspace:*",
    "extract-zip": "^2.0.1",
    "pouchdb": "^9.0.0",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-cli": "workspace:*",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.1",
    "@types/pouchdb": "^6.4.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "tailwindcss": "^4.1.17",
    "eslint-plugin-vue": "^10.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue": "^3.5.26",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.2"
  },
  "keywords": [
    "kisaki",
    "extension",
    "vnite",
    "import",
    "backup",
    "game"
  ],
  "license": "MIT"
}
