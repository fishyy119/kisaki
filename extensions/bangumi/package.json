{
  "name": "@kisaki3/builtin-bangumi",
  "private": true,
  "description": "Built-in Bangumi scraper and integration extension for Kisaki",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "kisx build",
    "dev": "kisx dev",
    "validate": "kisx validate",
    "pack": "kisx pack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.host.json --composite false && vue-tsc --noEmit -p tsconfig.ui.json --composite false"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.1",
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-cli": "workspace:*",
    "@kisaki3/extension-sdk": "workspace:*",
    "@kisaki3/extension-ui-vue": "workspace:*",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint-plugin-vue": "^10.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue": "^3.5.26",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.2"
  },
  "keywords": [
    "kisaki",
    "extension",
    "bangumi",
    "scraper"
  ],
  "license": "MIT"
}
