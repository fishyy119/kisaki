{
  "name": "@kisaki3/builtin-ymgal",
  "private": true,
  "description": "Built-in YMGal scraper extension for Kisaki",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "kisx build",
    "dev": "kisx dev",
    "validate": "kisx validate",
    "pack": "kisx pack",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.host.json --composite false && vue-tsc --noEmit -p tsconfig.ui.json --composite false",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run validate"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "catalog:",
    "@kisaki3/extension-api": "workspace:*",
    "@kisaki3/extension-cli": "workspace:*",
    "@kisaki3/extension-sdk": "workspace:*",
    "@kisaki3/extension-ui-vue": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  },
  "keywords": [
    "kisaki",
    "extension",
    "ymgal",
    "galgame",
    "scraper"
  ],
  "license": "MIT"
}
